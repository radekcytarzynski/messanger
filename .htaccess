Options -Indexes

# Pliki z danymi do bazy i kod pomocniczy nie są dostępne z przeglądarki.
<FilesMatch "^(config\.php|config\.sample\.php|lib\.php|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Wymuszenie HTTPS (odkomentuj, jeśli hosting nie robi tego sam):
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
